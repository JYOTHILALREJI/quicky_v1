<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Onboarding location capture — feeds the distance-based discovery filter -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Push notifications (v3.3): runtime permission on Android 13+;
         below Android 13 notifications are granted by default and only
         channels matter. Requested once, after sign-in (never during
         auth/onboarding). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Club voice messages (v3.3.4): real mic capture via MediaRecorder;
         requested at the mic button, only when the user records. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- AdMob (v2.1 §3.6): this is Google's OFFICIAL TEST application id.
             It MUST be replaced with the real AdMob app id
             (ca-app-pub-XXXX~XXXX) before shipping to production. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- FCM (v3.3): channel for background `notification` payloads that
             FCM itself renders (data payloads pick their channel per
             `type` in PushNotifications.show). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />

        <!-- FCM entry point: token refresh + foreground message handling
             for match / message / club alerts. -->
        <service
            android:name=".data.QuickyPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Live Face Verification (Get Verified): hands the temp selfie
             capture file to the system camera via ActivityResultContracts
             .TakePicture — no CAMERA permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aistudio.sparkdating.kqwzt.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google OAuth return deep link from Supabase Auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="quicky"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
