<?xml version="1.0" encoding="utf-8"?>
<!--
  Native ad card layout for the Discovery deck (Quicky v3.2 PRD §5).
  Bound to a loaded NativeAd via NativeAdView in AdsComponents.kt so every
  asset (media / headline / body / CTA) is registered for impression +
  click tracking. Uses plain framework views (no extra dependencies).

  v3.2 CONTAINER STRUCTURE (PRD §5 target):
    ┌─────────────────────────┐
    │      AD MEDIA           │  ← MediaView fills the card
    │   [ Image / Video ]     │
    │ ────── scrim ────────── │  ← bottom gradient keeps text readable
    │  Headline               │
    │  Body text              │
    │  [ Install ]  CTA pill  │
    └─────────────────────────┘
  The deep-ink card background keeps white text readable even when an ad
  has no media asset; content is vertically bottom-anchored (never a huge
  floating white area). NOTE (PRD §5.1): the "Test Ad" badge on the media
  asset is the AdMob VALIDATOR overlay that test creatives carry — it is
  development-only and never appears with production ad units.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF272740">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ad media (image / video) fills the whole card. -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Bottom text block over a vertical scrim gradient. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="34dp"
            android:paddingBottom="18dp"
            android:background="@drawable/ad_scrim_bottom">

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F2FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/ad_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ad_cta_pill"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
